#!/usr/bin/env bash
#
# Version and build number for aerospike-tools-validation. The VERSION file at
# the repo root is the source of truth; git only adds the build number and the
# dev-branch suffix.
#
# Usage:
#   build/version              -> master: x.y.z-n (x.y.z when n is 0); dev branches: same as -v
#   build/version -v           -> master: x.y.z; dev branches: x.y.z-<n>-g<sha>
#   build/version -r           -> master: n + 1 (so the VERSION bump is build 1); dev branches: 1
#
# n counts first-parent commits since the commit that last changed VERSION.
# When n cannot be counted (shallow clone, VERSION never committed), master -r
# and default fail; dev branches warn and use 0.
# With no .git at the repo root (a source tarball), -v prints VERSION and -r
# prints 1.
#
# Consumed by the top-level Makefile (the binary's version), pkg/Makefile.rpm
# and pkg/Makefile.deb (package version and RPM Release / DEB revision).

set -uo pipefail

mode=full
while [[ $# -gt 0 ]]; do
    case "$1" in
    -v)
        if [[ "$mode" != "full" ]]; then
            echo "Usage: $(basename "$0") [-v|-r]" >&2
            exit 1
        fi
        mode=version_only
        ;;
    -r)
        if [[ "$mode" != "full" ]]; then
            echo "Usage: $(basename "$0") [-v|-r]" >&2
            exit 1
        fi
        mode=build_only
        ;;
    *)
        echo "Usage: $(basename "$0") [-v|-r]" >&2
        exit 1
        ;;
    esac
    shift
done

CDPATH='' cd -- "$(dirname "$0")/.." || exit 1

_read_version() {
    local version

    if [[ ! -f VERSION ]]; then
        echo "error: no VERSION file in $(pwd)" >&2
        return 1
    fi

    version="$(cat VERSION)"
    if [[ ! "$version" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ||
        "$(cat VERSION; echo .)" != "$version"$'\n.' ]]; then
        echo "error: VERSION must be one line holding x.y.z, got '$version'" >&2
        return 1
    fi
    echo "$version"
}

_is_release_branch() {
    [[ "$1" == "master" ]]
}

# Determine branch name. Tries, in order: local branch name, common CI env vars
# (covers detached HEAD checkouts), then the first remote branch containing HEAD.
_resolve_branch() {
    local branch=""

    branch="$(git branch --show-current 2>/dev/null || true)"
    if [[ -n "$branch" ]]; then
        echo "$branch"
        return
    fi

    if [[ -n "${GITHUB_HEAD_REF:-}" ]]; then
        echo "$GITHUB_HEAD_REF"
        return
    fi
    if [[ -n "${GITHUB_REF:-}" && "$GITHUB_REF" == refs/heads/* ]]; then
        echo "${GITHUB_REF#refs/heads/}"
        return
    fi
    if [[ -n "${CI_COMMIT_REF_NAME:-}" ]]; then
        echo "$CI_COMMIT_REF_NAME"
        return
    fi

    # grep -Ev '/HEAD ->' avoids matching symbolic HEAD refs; strip remote prefix.
    branch="$(git branch -r --contains HEAD 2>/dev/null |
        grep -Ev '/HEAD ->' | head -1 |
        sed -e 's|^[^/]*/||' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' || true)"
    echo "$branch"
}

_commits_since_bump() {
    local level=$1 bump

    if [[ "$(git rev-parse --is-shallow-repository 2>/dev/null)" == "true" ]]; then
        echo "$level: shallow clone, so the commits since VERSION changed cannot be counted; fetch the full history" >&2
        return 1
    fi
    bump="$(git rev-list --first-parent -1 HEAD -- VERSION 2>/dev/null)" || bump=""
    if [[ -z "$bump" ]]; then
        echo "$level: no commit in this history changes VERSION" >&2
        return 1
    fi
    git rev-list --first-parent --count "${bump}..HEAD"
}

version="$(_read_version)" || exit 1

if [[ ! -e .git ]]; then
    if [[ "$mode" == "build_only" ]]; then
        echo 1
    else
        echo "$version"
    fi
    exit 0
fi
git rev-parse --git-dir >/dev/null || exit 1

if ! _is_release_branch "$(_resolve_branch)"; then
    if [[ "$mode" == "build_only" ]]; then
        echo 1
    else
        n="$(_commits_since_bump warning)" || n=0
        sha="$(git rev-parse --short=9 HEAD)" || exit 1
        echo "${version}-${n}-g${sha}"
    fi
    exit 0
fi

if [[ "$mode" == "version_only" ]]; then
    echo "$version"
    exit 0
fi

n="$(_commits_since_bump error)" || exit 1
if [[ "$mode" == "build_only" ]]; then
    echo "$((n + 1))"
elif [[ "$n" == "0" ]]; then
    echo "$version"
else
    echo "${version}-${n}"
fi
