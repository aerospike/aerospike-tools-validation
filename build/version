#!/usr/bin/env bash
#
# Version for aerospike-tools-validation. The VERSION file at the repo root is
# the source of truth; git only adds the dev-branch suffix.
#
# Usage:
#   build/version -v   -> master: VERSION (x.y.z or x.y.z-rcN); dev branches: <VERSION>-<n>-g<sha>
#
# n counts first-parent commits since the commit that last changed VERSION.
# When n cannot be counted (shallow clone, VERSION never committed), it warns
# and uses 0. With no .git at the repo root (a source tarball), it prints
# VERSION.
#
# Consumed by the top-level Makefile (the binary's version) and pkg/Makefile
# (package version and iteration, through .github/bin/pkg_release.sh).

set -uo pipefail

if [[ $# -ne 1 || "$1" != "-v" ]]; then
    echo "Usage: $(basename "$0") -v" >&2
    exit 1
fi

CDPATH='' cd -- "$(dirname "$0")/.." || exit 1

_read_version() {
    local version

    if [[ ! -f VERSION ]]; then
        echo "error: no VERSION file in $(pwd)" >&2
        return 1
    fi

    version="$(cat VERSION)"
    if [[ ! "$version" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-rc[1-9][0-9]{0,3})?$ ||
        "$(cat VERSION; echo .)" != "$version"$'\n.' ]]; then
        echo "error: VERSION must be one line holding x.y.z or x.y.z-rcN, got '$version'" >&2
        return 1
    fi
    echo "$version"
}

_is_release_branch() {
    [[ "$1" == "master" ]]
}

# Determine branch name. Tries, in order: local branch name, common CI env vars
# (covers detached HEAD checkouts), then the first remote branch containing HEAD.
_resolve_branch() {
    local branch=""

    branch="$(git branch --show-current 2>/dev/null || true)"
    if [[ -n "$branch" ]]; then
        echo "$branch"
        return
    fi

    if [[ -n "${GITHUB_HEAD_REF:-}" ]]; then
        echo "$GITHUB_HEAD_REF"
        return
    fi
    if [[ -n "${GITHUB_REF:-}" && "$GITHUB_REF" == refs/heads/* ]]; then
        echo "${GITHUB_REF#refs/heads/}"
        return
    fi
    if [[ -n "${CI_COMMIT_REF_NAME:-}" ]]; then
        echo "$CI_COMMIT_REF_NAME"
        return
    fi

    # grep -Ev '/HEAD ->' avoids matching symbolic HEAD refs; strip remote prefix.
    branch="$(git branch -r --contains HEAD 2>/dev/null |
        grep -Ev '/HEAD ->' | head -1 |
        sed -e 's|^[^/]*/||' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' || true)"
    echo "$branch"
}

_commits_since_bump() {
    local bump

    if [[ "$(git rev-parse --is-shallow-repository 2>/dev/null)" == "true" ]]; then
        echo "warning: shallow clone, so the commits since VERSION changed cannot be counted; fetch the full history" >&2
        return 1
    fi
    bump="$(git rev-list --first-parent -1 HEAD -- VERSION 2>/dev/null)" || bump=""
    if [[ -z "$bump" ]]; then
        echo "warning: no commit in this history changes VERSION" >&2
        return 1
    fi
    git rev-list --first-parent --count "${bump}..HEAD"
}

version="$(_read_version)" || exit 1

if [[ ! -e .git ]]; then
    echo "$version"
    exit 0
fi
git rev-parse --git-dir >/dev/null || exit 1

if _is_release_branch "$(_resolve_branch)"; then
    echo "$version"
    exit 0
fi

n="$(_commits_since_bump)" || n=0
sha="$(git rev-parse --short=9 HEAD)" || exit 1
echo "${version}-${n}-g${sha}"
